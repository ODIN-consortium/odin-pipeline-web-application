# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and never committed.
#
# ── PATH FORMAT ───────────────────────────────────────────────────────────────
# All path variables accept any format; the backend normalises them:
#
#   Windows:    <drive>:/ODIN     or  <drive>:\ODIN
#   Git Bash:   /<drive>/ODIN
#   WSL2:       /mnt/<drive>/ODIN
#
# ODIN_PIPELINE_ROOT is special: it is used verbatim as a Docker volume mount
# path in docker-compose.yml and must be in WSL2 format (/mnt/<drive>/...)
# when running Docker on Windows.
#
# ── MINIMUM REQUIRED SETTINGS ────────────────────────────────────────────────
# Set ODIN_PIPELINE_ROOT and the system works out of the box if you place your
# files in the expected subdirectory structure shown below.
#
#   $ODIN_PIPELINE_ROOT/
#     minknow/                     ← MinKNOW sequencing output
#     output/                      ← Nextflow pipeline results
#     biomeme/                     ← Biomeme data files
#     databases/
#       combined_pathogens/        ← Kraken2/Bracken database directory
#         hash.k2d                 ← Kraken2 hash (large, ~4-8 GB)
#         opts.k2d
#         taxo.k2d
#         database150mers.kmer_distrib   ← Bracken distribution file
#     input_sheets/
#       databases.csv              ← Taxprofiler DB definitions (auto-detected)
#       pathogens.xlsx             ← Pathogen annotation file (auto-detected)
#     enlighten/
#       data/                      ← Enlighten output (auto-created)
#
# Settings derived automatically from ODIN_PIPELINE_ROOT (no extra env vars needed):
#   minknow_dir          = $ODIN_PIPELINE_ROOT/minknow
#   output_dir           = $ODIN_PIPELINE_ROOT/output
#   biomeme_dir          = $ODIN_PIPELINE_ROOT/biomeme
#   enlighten_data_path  = $ODIN_PIPELINE_ROOT/enlighten/data
#   databases_file       = $ODIN_PIPELINE_ROOT/input_sheets/databases.csv
#   pathogens_file       = $ODIN_PIPELINE_ROOT/input_sheets/pathogens.xlsx
# =============================================================================

# Root data directory.  REQUIRED — there is no default.
# Every path setting is derived from it (see the list above), so the backend refuses
# to start without it, and `docker compose up` fails too because the value is used
# verbatim as a bind-mount path.  Set it to where your data actually lives:
ODIN_PIPELINE_ROOT=/mnt/<drive>/ODIN

# Name identifying this computer/operator.  REQUIRED — there is no default.
# It is stamped into created_by/updated_by on every row and into sync export
# filenames, which is how data from different machines is told apart when merging.
# Keep it stable: changing it makes this one machine look like two different
# devices once data is merged.
# Set it HERE rather than only in the Settings UI — .env lives on the host, so the
# value survives the container being recreated.  (The container's own hostname is a
# throwaway ID that changes each time, which is why it is not used as a fallback:
# it would silently scatter one machine's rows across several phantom devices.)
# Required for correct attribution rather than for startup: the app still runs if
# you leave it unset, but rows carry NULL and the Sync page warns you.
ODIN_DEVICE_NAME=field-laptop-01

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# ODIN has no login by default. Set BOTH variables below to require HTTP Basic
# Auth across the whole app — the frontend (UI + /api/ proxy) and the backend API
# both enforce these same credentials, so it also covers requests that reach the
# API directly. Strongly recommended if the machine is reachable by anyone else —
# see SECURITY.md. Leave both unset to run without a login (loopback / trusted use).
# ODIN_AUTH_USER=odin
# ODIN_AUTH_PASSWORD=change-me

# ── OPTIONAL OVERRIDES ────────────────────────────────────────────────────────
# The following settings have sensible defaults derived from ODIN_PIPELINE_ROOT.
# Uncomment and edit only if you need a non-default location.

# Directory containing Kraken2/Bracken databases.  Default: $ODIN_PIPELINE_ROOT/databases
# Only needed if your databases live outside ODIN_PIPELINE_ROOT (e.g. on a different drive).
# When set, also uncomment the ODIN_DATABASE_PATH volume line in docker-compose.yml.
# ODIN_DATABASE_PATH=/mnt/<drive>/ODIN/databases

# Path to the taxprofiler databases CSV.
# Default: $ODIN_PIPELINE_ROOT/input_sheets/databases.csv
# The bundled example (config/databases.csv) uses relative db_path values
# resolved against ODIN_DATABASE_PATH at runtime.
# ODIN_DATABASES_FILE=/mnt/<drive>/ODIN/input_sheets/databases.csv

# Path to the pathogens Excel file for Kraken2 result annotation.
# Default: $ODIN_PIPELINE_ROOT/input_sheets/pathogens.xlsx
# ODIN_PATHOGENS_FILE=/mnt/<drive>/ODIN/input_sheets/pathogens.xlsx

# MinKNOW output directory scanned by the dashboard's discovery.
# Default: $ODIN_PIPELINE_ROOT/minknow
# IMPORTANT: a path outside ODIN_PIPELINE_ROOT is invisible to the containers until it
# is ALSO mounted host:container identically — uncomment the matching volume line in
# docker-compose.yml (odin-app-api). The pipelines read FASTQ straight from this
# directory, and their task containers bind the paths from the host (DooD).
# ODIN_MINKNOW_DIR=/mnt/<drive>/sequencing/minknow

# Nextflow profile to activate (odin = 4 CPU / 16 GB, odin_big = 16 CPU / 31 GB).
# Default: odin
# NEXTFLOW_PROFILE=odin

# Path to a custom Nextflow config file.  Default: the config baked into the image.
# Can also point to a file under ODIN_PIPELINE_ROOT — already mounted in the container.
# NEXTFLOW_CONFIG_FILE=/mnt/<drive>/ODIN/config/odin.config

# ── CORPORATE SSL INSPECTION ──────────────────────────────────────────────────
# Only needed when running behind a firewall that performs SSL interception.
# Leave commented out on standard networks.
#
# Easiest: place your cert (PEM format) in $ODIN_PIPELINE_ROOT/ca/ — the
# backend container auto-discovers any *.cer/*.crt/*.pem file there at startup.
# No env var needed in that case.
#
# Only set ODIN_CA_CERT if your cert lives outside ODIN_PIPELINE_ROOT (also add
# a matching volume entry in docker-compose.yml for that path).
# ODIN_CA_CERT=/mnt/<drive>/ODIN/ca/your-ca.cer

# ── PERFORMANCE TUNING ────────────────────────────────────────────────────────
# Recommended on Windows/WSL2: use WSL2-native Linux filesystem paths to avoid
# slow I/O through the 9P/v9fs Windows filesystem bridge.

# Persistent cache for wf-metagenomics and mpox database downloads.
# If unset, uses the odin-store Docker named volume (already configured).
# ODIN_STORE_DIR=/home/<your-wsl-user>/odin_store

# Base directory for Nextflow work directories.
# If unset, work dirs are created under $ODIN_PIPELINE_ROOT/output/nanopore_processed/
# On Windows/WSL2, set this to a WSL2-native path to avoid v9fs I/O failures.
# docker-compose.yml mounts this path identically (host:container) so sibling
# pipeline containers can reach it via the Docker socket.
# Docker auto-creates the directory on first launch — no mkdir needed.
# ODIN_WORK_DIR=/home/<your-wsl-user>/odin_work

# Temporary directory for FASTQ concatenation before pipeline launch.
# If unset, defaults to /var/tmp
# ODIN_TMP_DIR=/var/tmp

# Directory for ODIN streaming logs and Nextflow .nextflow.log.
# If unset, defaults to $ODIN_PIPELINE_ROOT/output/pipeline_logs
# ODIN_LOG_DIR=/home/<your-wsl-user>/odin_logs

# ── ADVANCED / RARELY CHANGED ─────────────────────────────────────────────────

# Docker image for squirrel phylogenetic analysis (mpox post-processing).
# Default: articnetworkorg/squirrel:1.3.2
# Override only if you need a specific version or a locally built image.
# SQUIRREL_IMAGE=articnetworkorg/squirrel:1.3.2

# nf-core/taxprofiler revision to pull from GitHub.
# TAXPROFILER_REVISION=1.2.6

# Full path to the nextflow executable (default: nextflow on PATH).
# NF_BIN=/usr/local/bin/nextflow

# Path to a local nf-core/taxprofiler checkout (avoids GitHub pull).
# TAXPROFILER_DIR=/mnt/<drive>/ODIN/tools/taxprofiler

# CSV delimiter and decimal separator for seed files (sites.csv, samples.csv).
# ODIN_CSV_DELIMITER=;
# ODIN_CSV_DECIMAL=,

